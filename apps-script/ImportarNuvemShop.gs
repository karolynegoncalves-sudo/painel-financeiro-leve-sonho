/**
 * ImportarNuvemShop.gs — importação única dos produtos já precificados
 * no canal NuvemShop (extraídos da planilha FPV real dela, 92 produtos).
 * Rode importarProdutosNuvemShop_() UMA VEZ pelo menu de funções. Se a
 * aba Precificação já tiver algum produto do canal NuvemShop_Cartao, a
 * função para sozinha pra não duplicar.
 *
 * Os nomes foram reconstruídos a partir do material principal + preço
 * de venda, porque a planilha original não tinha um nome próprio pra
 * cada variação (o texto de identificação era igual em quase todos os
 * blocos) — revise/renomeie os que fizer sentido depois de importado.
 */
function importarProdutosNuvemShop_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(ABA_PRECIFICACAO);
  const dados = sheetData_(ABA_PRECIFICACAO);
  const idx = function (n) { return dados.headers.indexOf(n); };
  const iCanal = idx('canal');
  const jaImportado = dados.rows.some(function (r) { return r[iCanal] === 'NuvemShop_Cartao'; });
  if (jaImportado) {
    Logger.log('Já existem produtos NuvemShop_Cartao na aba Precificação — importação abortada pra não duplicar.');
    return;
  }

  const email = Session.getActiveUser().getEmail();
  const agora = new Date();
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const linhas = PRODUTOS_NUVEMSHOP_IMPORT_.map(function (p) {
      const custoProduto = custoProdutoServer_(p.materiais, p.maoDeObra, p.outros);
      const custoVariavelPct = custoVariavelPctServer_(p.tarifas);
      const snap = breakdownServer_(p.precoVenda, custoProduto, custoVariavelPct, p.despesasFixasPct);
      return [
        Utilities.getUuid(), p.nome, p.canal, true,
        JSON.stringify(p.materiais || []), JSON.stringify(p.maoDeObra || []),
        JSON.stringify(p.outros || []), JSON.stringify(p.tarifas || {}),
        p.despesasFixasPct, p.precoVenda,
        custoProduto, snap.lucroPct, snap.margemContribuicaoPct, snap.markup,
        agora, email, agora, email
      ];
    });
    const primeiraLinhaVazia = sheet.getLastRow() + 1;
    sheet.getRange(primeiraLinhaVazia, 1, linhas.length, linhas[0].length).setValues(linhas);
    Logger.log('Importados ' + linhas.length + ' produtos do NuvemShop.');
  } finally {
    lock.releaseLock();
  }
}

